{
  "expo": {
    "name": "Thornton CC Cheltenham Tipp App",
    "slug": "tcc-cheltenham",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.tcccheltenham"
    },
"web": {
  "favicon": "./icon.png"
},
"plugins": [
  "expo-router"
]
  }
}
